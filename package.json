{
  "name": "playlist-checker",
  "version": "0.1.0",
  "description": "See which tracks in a Spotify playlist you have already heard on Last.fm, and keep only the new ones.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "homepage": "https://playlistchecker.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xfuturomax/playlist-checker.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test test/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && node --test test/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "wrangler": "^4.147.0"
  }
}
